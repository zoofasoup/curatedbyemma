# OpenRouter API Key for authentic, context-aware 4-part replies
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default fast & high-intelligence model
# Options: google/gemini-2.5-flash, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=google/gemini-2.5-flash
